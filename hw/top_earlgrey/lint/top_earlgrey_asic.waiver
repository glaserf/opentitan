# waiver file for top_earlgrey_asic (and the earlgrey power domain submodules)

# dedicated reset drivers / muxes
set_reset_drivers prim_clock_mux2 prim_flop_2sync prim_flop
set_clock_drivers prim_clock_buf prim_clock_mux2

# All leaf resets have a reset multiplex
waive -rules RESET_MUX -location {top_earlgrey_asic.sv earlgrey_pd_main.sv earlgrey_pd_aon.sv} -regexp {Asynchronous reset .*rstmgr_aon_resets(_i|_o)?\.rst.* is driven by a multiplexer} \
      -comment "This is dedicated reset infrastructure, and hence permissible"

waive -rules RESET_MUX -location {rstmgr.sv rstmgr_por.sv rstmgr_ctrl.sv} -regexp {Asynchronous reset '(resets_o\.)?rst_[A-Za-z_0-9]+_n(\[[0-9:]+\])?' is driven by a multiplexer} \
      -comment "This is dedicated reset infrastructure, and hence permissible"

waive -rules RESET_MUX -location {rstmgr.sv} -regexp {Asynchronous reset 'scan_rst_ni' reaches a multiplexer} \
      -comment "This is dedicated reset infrastructure, and hence permissible"

waive -rules RESET_MUX -location {spi_device.sv} -regexp {Asynchronous reset '(rst_ni|rst_spi_n)' reaches a multiplexer} \
      -comment "This is dedicated reset infrastructure, and hence permissible"

waive -rules CLOCK_USE -location {top_earlgrey_asic.sv earlgrey_pd_main.sv} -regexp {'clkmgr_aon_clocks.clk_io_div2_peri' is connected to 'spi_device' port 'scan_clk_i', and used as a clock} \
      -comment "This connection is a scan clock connection."

# Clock and reset feedthrough across the new wrapper hierarchy. The wrapper
# (top_earlgrey_asic) holds the AST and distributes the clkmgr_aon_clocks /
# rstmgr_aon_resets structs (which originate inside earlgrey_pd_aon) to the
# AST and the earlgrey_pd_main / earlgrey_pd_aon instances.
waive -rules {CLOCK_USE} -location {top_earlgrey_asic.sv} -regexp {'clkmgr_aon_clocks..*' is connected to '(ast|earlgrey_pd_main|earlgrey_pd_aon)' port '(sns_clks_i..*|clk_ast_usb_i|clkmgr_aon_clocks_(i|o)..*)', and used as a clock} \
      -comment "Clock struct feedthrough across the wrapper into AST and the power domains."

waive -rules {RESET_USE} -location {top_earlgrey_asic.sv} -regexp {'rstmgr_aon_resets..*' is connected to '(ast|earlgrey_pd_main|earlgrey_pd_aon)' port '(sns_rsts_i..*|rstmgr_aon_resets_(i|o)..*)', and used as an asynchronous reset or set} \
      -comment "Reset struct feedthrough across the wrapper into AST and the power domains."

waive -rules {CLOCK_MUX} -location {top_earlgrey_asic.sv} -regexp {Clock 'ast_base_clks\.clk_io' reaches a multiplexer here, used as a clock 'clk_i' at} \
      -comment "ast_base_clks.clk_io is fed into the clkmgr's clock dividers / scan bypass mux."

waive -rules CLOCK_MUX -location {top_earlgrey_asic.sv earlgrey_pd_main.sv earlgrey_pd_aon.sv} -regexp {.*clk_io_div.* is driven by a multiplexer here} \
      -comment "Divided clocks go through prim_clock_div, which use muxes for scan bypass and clock step down"

waive -rules CLOCK_MUX -location {earlgrey_pd_aon.sv} -regexp {Clock 'clk_io_i' reaches a multiplexer here, used as a clock 'clk_i' at} \
      -comment "This is a clock signal that is fed back into AST."

waive -rules CLOCK_MUX -location {top_earlgrey_asic.sv earlgrey_pd_main.sv} -regexp {Clock 'spi_device_passthrough_req.sck' reaches a multiplexer here, used as a clock} \
      -comment "In passthrough mode, spi_host muxes 'spi_device_passthrough_req.sck' to the `cio_sck_o` output."

waive -rules CLOCK_MUX -location {top_earlgrey_asic.sv earlgrey_pd_main.sv} -regexp {Clock 'pinmux_aon_(lc|rv)_jtag_req.tck' is driven by a multiplexer here, used as a clock 'tck_i' at dmi_jtag_tap.sv} \
      -comment "Inside lc_ctrl/rv_dm, either the JTAG clock is muxed and forward to the DMI JTAG TAP depending on the scanmode/testmode signals."

waive -rules CLOCK_MUX -location {top_earlgrey_asic.sv earlgrey_pd_main.sv} -regexp {Clock 'mio_in_i\[38\]' reaches a multiplexer here, used as a clock 'tck_i' at dmi_jtag_tap.sv} \
      -comment "Inside pinmux_strap_sampling.sv, 'mio_in_i[TckPadIdx]' is connected to 'jtag_req' which is then muxed in the JTAG Selection Mux."

# scan reset is a legal asynchronous reset. The wrapper declares its local
# scan net as 'scan_rst_n' while the pd / IP ports are named 'scan_rst_ni',
# hence the optional trailing 'i' in the signal name match.
waive -rules RESET_USE -location {top_earlgrey_asic.sv earlgrey_pd_main.sv earlgrey_pd_aon.sv} -regexp {'scan_rst_ni?' is connected to .* port 'scan_rst_ni', and used as an asynchronous reset or set 'rst_.*ni' at} \
      -comment "Scan reset is a legal asynchronous reset"

# Wrapper-level AST observability signals.
waive -rules {CLOCK_USE} -location {top_earlgrey_asic.sv} -regexp {'sck_monitor' is connected to 'ast' port 'sns_spi_ext_clk_i', and used as a clock} \
      -comment "sck_monitor is the SPI sck observed by AST for clock detection."

# Dedicated I/O signals (SPI sck, etc.) can act as clocks and traverse the
# pinmux's wakeup mux on their way into IPs.
waive -rules {CLOCK_MUX} -location {top_earlgrey_asic.sv earlgrey_pd_main.sv} -regexp {Clock 'dio_in_i\[[0-9]+\]' reaches a multiplexer here, used as a clock 'clk_i' at} \
      -comment "Dedicated SPI sck (and similar) inputs can act as a clock; pinmux mux is legitimate."

# The wrapper exposes the AST POK and a few other struct members but only
# consumes the fields actually wired up.
waive -rules {NOT_READ HIER_NET_NOT_READ} -location {top_earlgrey_asic.sv} -regexp {(Signal|Net) 'ast_pwst(\.vcc_pok|\.io_pok|_h\.io_pok|_h\.main_pok|_h\.vcc_pok)' is not read from in module 'top_earlgrey_asic'} \
      -comment "Not all POK signals are consumed inside top_earlgrey_asic."

# IOA2 / IOA3 are analog out-only inout ports driven directly from the AST.
waive -rules {HIER_BRANCH_NOT_READ} -location {top_earlgrey_asic.sv} -regexp {Net 'IOA[23]' is not read from in module 'top_earlgrey_asic'} \
      -comment "IOA2 and IOA3 are analog AST outputs driven directly to chip pads."

waive -rules {INOUT_AS_OUT} -location {top_earlgrey_asic.sv} -regexp {Inout port 'IOA[23]' used as an output only in module 'top_earlgrey_asic'} \
      -comment "IOA2 and IOA3 are analog AST outputs driven directly to chip pads."

# CC1 / CC2 are analog inout ports driven from off-chip.
waive -rules {INOUT_AS_IN} -location {top_earlgrey_asic.sv} -regexp {Inout port 'CC[12]' has no driver in module 'top_earlgrey_asic'} \
      -comment "CC1 and CC2 are analog AST inputs (adc_a0_ai/adc_a1_ai) driven from off-chip."

# mio_in_raw is forwarded into the wrapper to expose the external clock pad
# tap and to feed the PAD2AST_WIRES macro. Indices not used are intentionally
# left unread.
waive -rules {NOT_READ HIER_NET_NOT_READ} -location {top_earlgrey_asic.sv} -regexp {(Signal|Net) 'mio_in_raw(\[[0-9:]+\])?' is not read from(,|.* in module 'top_earlgrey_asic')} \
      -comment "Only the external-clock pad index and PAD2AST_WIRES taps are consumed; the rest are intentionally unused."

# intentionally unused
waive -rules {NOT_READ HIER_NET_NOT_READ} -location {top_earlgrey_asic.sv earlgrey_pd_main.sv} -regexp {.*cio_otp_macro_test_(en_)?d2p\[7:1\].* is not read} \
      -comment "otp test bus made deliberately larger on purpose"

## xbar
#waive -rules HIER_NET_NOT_READ -location {tlul_xbar.sv} -regexp {a_source.* is not read from} \
#      -comment "upper bits of a_source are shifted off when going through M:1 sockets"
#waive -rules LINE_LENGTH -location {xbar_main.sv} -regexp {Line length of .* exceeds 100 character limit} \
#      -comment "This is a generated file and it is hence permissible to have line lengths that exceed this limit"

# Possible tool shortcomings

waive -rules CLOCK_USE -location {top_earlgrey_asic.sv earlgrey_pd_main.sv} -regexp {'clkmgr_aon_clocks.clk_io_div4_secure' is connected to 'pwrmgr' port 'clk_esc_i', and used as a clock 'clk_i' at tlul_socket_1n.sv} \
      -comment "The tool for reasons unknown is unable to trace through a prim buf wrap cell to understand the clock is being used as a clock. If a direct assign is used, the error goes away."

waive -rules CLOCK_USE -location {top_earlgrey_asic.sv earlgrey_pd_main.sv} -regexp {'clkmgr_aon_clocks.clk_io_div4_powerup' is connected to 'pwrmgr' port 'clk_lc_i', and used as a clock 'clk_i' at tlul_socket_1n.sv} \
      -comment "The tool for reasons unknown is unable to trace through a prim buf wrap cell to understand the clock is being used as a clock. If a direct assign is used, the error goes away."

# Most SAME_NAME_TYPE issues have been fixed. There are however some that overlap due to similar terminology.
# Since these functions / parameters / signals live in different scopes, this is acceptable, and we can waive them.
waive -rules SAME_NAME_TYPE -location {aes_sbox_canright_pkg.sv keccak_2share.sv} -regexp {'theta' is used as a (reg|function) here, and as a (function|reg) at} \
      -comment {This is acceptable, since these are used in different hierarchies.}
waive -rules SAME_NAME_TYPE -location {keccak_round.sv otbn_pkg.sv} -regexp {'L' is used as a (parameter|reg) here, and as a (reg|parameter) at} \
      -comment {This is acceptable, since these are used in different hierarchies.}
waive -rules SAME_NAME_TYPE -location {spi_device.sv rstmgr_pkg.sv} -regexp {'spi_device' is used as a (module|reg) here, and as a (reg|module) at } \
      -comment {This is acceptable, since these are used in different hierarchies.}
waive -rules SAME_NAME_TYPE -location {tlul_socket_m1.sv otbn_pkg.sv} -regexp {'M' is used as a (parameter|reg) here, and as a (reg|parameter) at} \
      -comment {This is acceptable, since these are used in different hierarchies.}

waive -rules {LINE_LENGTH} -location {top_earlgrey_asic.sv earlgrey_pd_main.sv earlgrey_pd_aon.sv} -regexp {Line length of [0-9]+ exceeds 100 character limit} \
      -comment "Earlgrey toplevels are auto-generated and adhering to the line length limit is not always feasible for auto-generated code"

waive -rules LINE_LENGTH -location {top_earlgrey_rnd_cnst_pkg.sv} -regexp {Line length of [0-9]+ exceeds 100 character limit} \
      -comment "top_earlgrey_rnd_cnst_pkg is auto-generated and adhering to the line length limit is not always feasible for auto-generated code"
